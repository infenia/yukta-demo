# Render puts the client address last in X-Forwarded-For; trust only that entry (no recursion), so a
# visitor cannot pick their own rate-limit bucket.
set_real_ip_from 0.0.0.0/0;
real_ip_header X-Forwarded-For;
real_ip_recursive off;

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

server {
  listen ${PORT};
  client_max_body_size 256k;

  # Same key in both headers, overriding whatever the browser sends.
  proxy_set_header Authorization "Bearer ${OPERATOR_KEY}";
  proxy_set_header X-API-Key "${OPERATOR_KEY}";
  proxy_set_header Host $host;
  proxy_http_version 1.1;
  proxy_set_header Connection "";

  # Not part of the demo: the MCP server, webhooks and the actuator (health stays open below).
  location /mcp { return 404; }
  location /hooks { return 404; }
  location /actuator { return 404; }
  location = /actuator/health { proxy_pass http://127.0.0.1:9858; }

  location /api/ {
    limit_req zone=api burst=40 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:9858;
    # SSE: live progress and logs
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  location / { proxy_pass http://127.0.0.1:9858; }
}
